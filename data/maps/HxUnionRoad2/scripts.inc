HxUnionRoad2_MapScripts::
	.byte 0

HxUnionRoad2_EventScript_Sign::
	msgbox HxUnionRoad2_Text_Sign, MSGBOX_SIGN
	end

HxUnionRoad2_Text_Sign::
	.string "UNION ROAD REST STOP\n"
	.string "Volunteers from CINNABAR run\l"
	.string "this camp for all travelers.$"

HxUnionRoad2_EventScript_OldMan::
	msgbox HxUnionRoad2_Text_OldMan, MSGBOX_NPC
	end

HxUnionRoad2_Text_OldMan::
	.string "They say the seabed rose up\n"
	.string "in a single night.\p"
	.string "I've fished these waters for\n"
	.string "sixty years. Never seen\l"
	.string "anything like it.$"

HxUnionRoad2_EventScript_Woman::
	msgbox HxUnionRoad2_Text_Woman, MSGBOX_NPC
	end

HxUnionRoad2_Text_Woman::
	.string "I came by boat from HOENN.\p"
	.string "The water just drained away,\n"
	.string "and I had to walk the rest!$"

HxUnionRoad2_EventScript_Boy::
	msgbox HxUnionRoad2_Text_Boy, MSGBOX_NPC
	end

HxUnionRoad2_Text_Boy::
	.string "I saw it! A huge red light\n"
	.string "under the sea near CINNABAR!\p"
	.string "The grown-ups say it was a\n"
	.string "legendary POKéMON…$"

HxUnionRoad2_EventScript_FatMan::
	msgbox HxUnionRoad2_Text_FatMan, MSGBOX_NPC
	end

HxUnionRoad2_Text_FatMan::
	.string "The POKéMON CENTER here is\n"
	.string "open to everyone.\p"
	.string "Rest up before you walk on!$"

HxUnionRoad2_EventScript_OldWoman::
	msgbox HxUnionRoad2_Text_OldWoman, MSGBOX_NPC
	end

HxUnionRoad2_Text_OldWoman::
	.string "My grandson went on ahead to\n"
	.string "HOENN with his POKéMON.\p"
	.string "I hope this road holds…$"

HxUnionRoad2_EventScript_Expert::
	msgbox HxUnionRoad2_Text_Expert, MSGBOX_NPC
	end

HxUnionRoad2_Text_Expert::
	.string "Notice the tide? The sea keeps\n"
	.string "pushing against the road.\p"
	.string "Land and sea are fighting over\n"
	.string "this place. It can't last.$"

HxUnionRoad2_EventScript_Pokefan::
	msgbox HxUnionRoad2_Text_Pokefan, MSGBOX_NPC
	end

HxUnionRoad2_Text_Pokefan::
	.string "I hear SLATEPORT is already\n"
	.string "packed with people from KANTO.$"

HxUnionRoad2_EventScript_Kid::
	msgbox HxUnionRoad2_Text_Kid, MSGBOX_NPC
	end

HxUnionRoad2_Text_Kid::
	.string "I'm going to battle my way\n"
	.string "all the way to HOENN!\p"
	.string "Trainers keep coming through\n"
	.string "here. It's great!$"

